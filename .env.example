# =============================================================================
# Cosmiclly — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# Frontend (React / Vite) — These are embedded in the client bundle (public)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
VITE_VAPI_PUBLIC_KEY="your-vapi-public-key"

# Python (Execution Scripts) — Used by local Python scripts only
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"

# =============================================================================
# The following secrets are NOT stored in .env — they are set as
# Supabase Edge Function secrets via `supabase secrets set`:
#
#   STRIPE_SECRET_KEY        — Stripe server-side operations
#   STRIPE_WEBHOOK_SECRET    — Stripe webhook signature verification
#   LIVEKIT_API_KEY          — LiveKit token generation
#   LIVEKIT_API_SECRET       — LiveKit token signing
#   LIVEKIT_URL              — LiveKit WebSocket URL
#   OPENAI_API_KEY           — Embeddings + chat completions (Twin AI)
#   CARTESIA_API_KEY         — Voice cloning API (Twin AI)
#   VAPI_API_KEY             — Vapi agent management (Twin AI)
#   BREVO_API_KEY            — Brevo transactional email
#   ALLOWED_ORIGIN           — CORS allowed origin (default: https://cosmiclly.com)
# =============================================================================
